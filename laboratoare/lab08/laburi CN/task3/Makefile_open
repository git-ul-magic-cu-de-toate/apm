COMPILER = iverilog
INTERPRETER = vvp
SIMULATOR = gtkwave
FLAGS = -Wall -Winfloop
TOP_MODULE = task3
TOP_SIM_MODULE = test_$(TOP_MODULE)
OTHER_SOURCES = ../task0/task01.v ../task1/task1.v ../task2/task2.v ../utils/debouncer.v ../utils/display7LED.v
DUMP_VCD_FILE = test.vcd

all: build

build:
	$(COMPILER) $(FLAGS) $(TOP_MODULE).v $(TOP_SIM_MODULE).v $(OTHER_SOURCES) -o $(TOP_MODULE).vvp

run: build
	$(INTERPRETER) $(TOP_MODULE).vvp

simulation: run
	$(SIMULATOR) $(DUMP_VCD_FILE)

clean:
	rm $(TOP_MODULE).vvp $(DUMP_VCD_FILE)
